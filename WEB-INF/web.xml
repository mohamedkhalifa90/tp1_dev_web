<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>FormServlet</servlet-name>
        <servlet-class>servlets.FormServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FormServlet</servlet-name>
        <url-pattern>/FormServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FormServlet</servlet-name>
        <url-pattern>/Form_Servlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ReadCookie</servlet-name>
        <servlet-class>servlets.ReadCookie</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ReadCookie</servlet-name>
        <url-pattern>/ReadCookie</url-pattern>
    </servlet-mapping>
    <servlet>
    <servlet-name>VisitCounter</servlet-name>
    <servlet-class>servlets.VisitCounter</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>VisitCounter</servlet-name>
    <url-pattern>/VisitCounter</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>ShowSession</servlet-name>
    <servlet-class>servlets.ShowSession</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ShowSession</servlet-name>
    <url-pattern>/ShowSession</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>ListItems</servlet-name>
    <servlet-class>servlets.ListItems</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ListItems</servlet-name>
    <url-pattern>/ListItems</url-pattern>
</servlet-mapping>

</web-app>